{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Microcontroller Simulator",
  "version": "../package.json",
  "identifier": "ua.lpnu.microcontroller-simulator",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Microcontroller Simulator",
        "width": 1440,
        "height": 920,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost",
      "devCsp": "default-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' http://localhost:5173 ws://localhost:5173 data: ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Microcontroller simulator (von Neumann, CISC)",
    "category": "Education"
  }
}